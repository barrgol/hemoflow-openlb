<?xml version="1.0" ?>

<simulation>
	<blockSize>20</blockSize>
	<outputDir>../output</outputDir>
	<simLength>1.4</simLength>
	<saveFrequency>0.01</saveFrequency>
	<saveInitState>1</saveInitState>
	<saveZeroState>1</saveZeroState>
	<write2hdf5>1</write2hdf5>
</simulation>

<fluid>
	<Re>600</Re>
	<U_AVG_LB>0.05</U_AVG_LB>
	<tau_LB>0.6</tau_LB>
	<kinematicViscosity>3.27e-6</kinematicViscosity>
	<!-- [kg/m3] -->
	<fluidDensity>1055</fluidDensity>
</fluid>

<geometry>
	<NumberofFlowrateFuncs>5</NumberofFlowrateFuncs>
	<!-- Note: Flowrate functions, not velocity functions -->
	<inletFlowrateFunc_SVC>../data/flowrateFuncs/SVC_unsteady.txt</inletFlowrateFunc_SVC>
	<inletFlowrateFunc_IVC>../data/flowrateFuncs/IVC_unsteady.txt</inletFlowrateFunc_IVC>
	<inletFlowrateFunc_LHV>../data/flowrateFuncs/LHV_unsteady.txt</inletFlowrateFunc_LHV>
	<inletFlowrateFunc_MHV>../data/flowrateFuncs/MHV_unsteady.txt</inletFlowrateFunc_MHV>
	<inletFlowrateFunc_RHV>../data/flowrateFuncs/RHV_unsteady.txt</inletFlowrateFunc_RHV>
	<!-- <outletFlowrateFunc_RPA>/home/kwang/VascuTreatCFD/data/Fontan_flowrate_funcs/RPA.txt</outletFlowrateFunc_RPA>
	<outletFlowrateFunc_LPA>/home/kwang/VascuTreatCFD/data/Fontan_flowrate_funcs/LPA.txt</outletFlowrateFunc_LPA>
	<outletFlowrateFunc_SIDE_V>/home/kwang/VascuTreatCFD/data/Fontan_flowrate_funcs/SIDE_V.txt</outletFlowrateFunc_SIDE_V>
	<outletFlowrateFunc_SIDE_P>/home/kwang/VascuTreatCFD/data/Fontan_flowrate_funcs/SIDE_P.txt</outletFlowrateFunc_SIDE_P>
	<outletFlowrateFunc_OutFlow>/home/kwang/VascuTreatCFD/data/Fontan_flowrate_funcs/OutFlow.txt</outletFlowrateFunc_OutFlow> -->
	<file>../data/voxelsops.npz</file>
	<GeometryFlag>../data/voxelsgf.h5</GeometryFlag>
</geometry>

<flowdiverter>
	<linCoeff>50.0</linCoeff>
	<quadCoeff>4200.0</quadCoeff>
</flowdiverter>